{
  "name": "instagrowth-desktop",
  "productName": "InstaGrowth Desktop",
  "version": "0.1.1",
  "description": "Pilote l'app Instagram d'un téléphone Android branché en USB (ADB) : likes vérifiés, lecture de bio, DM préparés et agent Claude.",
  "type": "module",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "sim": "electron . --sim",
    "selftest": "node scripts/selftest.mjs",
    "mock": "node scripts/mock-claude.mjs 4810",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "electron-builder --win nsis --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "author": "Lucas Burdier",
  "homepage": "https://github.com/lburdier/instagrowth",
  "repository": {
    "type": "git",
    "url": "https://github.com/lburdier/instagrowth.git"
  },
  "build": {
    "appId": "fr.instagrowth.desktop",
    "productName": "InstaGrowth Desktop",
    "copyright": "Lucas Burdier",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "InstaGrowth-Desktop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InstaGrowth Desktop",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/lburdier/instagrowth/releases/latest/download"
      }
    ]
  }
}
